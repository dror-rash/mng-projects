{
  "name": "mng-projects",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @repo/e2e e2e",
    "test:infra": "bash infra/scripts/test-environment.sh && bash infra/scripts/test-deploy-service.sh && node --experimental-strip-types --test --test-concurrency=1 infra/scripts/check-runtime-role.test.mjs infra/scripts/provision-db-logins.test.mjs infra/scripts/with-db-lock.test.mjs && bash infra/scripts/test-preview-migrate.sh && bash infra/scripts/test-workflows.sh",
    "storybook": "pnpm --filter @repo/ui storybook",
    "build-storybook": "pnpm --filter @repo/ui build-storybook",
    "db:up": "docker compose up -d db storage",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "scaffold": "bash scripts/create-project.sh",
    "test:scaffold": "bash scripts/test-scaffold.sh"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-gpj5-g38j-94v9",
        "GHSA-5gmw-xhrv-c9v3",
        "GHSA-85c8-ppgw-ccpr"
      ]
    },
    "overrides": {
      "next>postcss": "^8.5.18"
    }
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  },
  "description": "A full-stack multi-zone web app built from Waypoint"
}
